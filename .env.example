# ============================================================
# KEY TO KOCHI — Environment Variables Template
# Copy this file to .env and provide your actual values.
# NEVER commit your actual .env file to Git.
# ============================================================

# Authorized Admin Email
KTK_ADMIN_EMAIL=admin@example.com

# Admin Password (plaintext or SHA-256 hash)
KTK_ADMIN_PASS=your_admin_password_here
# KTK_ADMIN_PASS_HASH=

# SMTP Delivery for Two-Factor Email OTP
KTK_SMTP_HOST=smtp.gmail.com
KTK_SMTP_PORT=587
KTK_SMTP_SECURE=false
KTK_SMTP_USER=admin@example.com
KTK_SMTP_PASS=your_gmail_app_password_here
KTK_SMTP_FROM="KEY TO KOCHI <admin@example.com>"
