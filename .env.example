# ============================================================
# KEY TO KOCHI — Environment Variables Template
# Copy this file to .env and provide your actual values.
# NEVER commit your actual .env file to Git.
# ============================================================

# Authorized Admin Email
KTK_ADMIN_EMAIL=

# Admin Password (plaintext or SHA-256 hash)
KTK_ADMIN_PASS=
# KTK_ADMIN_PASS_HASH=

# SMTP Delivery — used for:
#   1. Admin Two-Factor OTP emails
#   2. Subscriber confirmation emails (Exclusive Property Alerts)
#   3. Admin notifications when a new subscriber signs up
#   4. Immediate property alert notifications when a new listing is published
#
KTK_SMTP_HOST=
KTK_SMTP_PORT=587
KTK_SMTP_SECURE=false
KTK_SMTP_USER=
KTK_SMTP_PASS=
KTK_SMTP_FROM=

# ============================================================
# Firebase / Cloud Firestore — Shared persistent database
# ============================================================

# Client-side Firebase config (VITE_ prefix exposes to browser bundle).
# These are project identifiers, NOT secrets.
# Firestore access is controlled by Security Rules, not by hiding these values.
#
# Get values from: Firebase Console → Project Settings → Your Apps → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase Admin SDK (Netlify Function — NOT exposed to browser).
# Get values from: Firebase Console → Project Settings → Service Accounts
#   → Generate new private key → download JSON → copy these three fields.
KTK_FIREBASE_PROJECT_ID=
KTK_FIREBASE_CLIENT_EMAIL=
KTK_FIREBASE_PRIVATE_KEY=

# Storage (gitignored):
#   - Subscribers: Firestore 'subscribers' collection (persistent, cross-device)
#   - Alert History: Firestore 'alertHistory' collection (persistent, deduplication)
