# ============================================================
# KEY TO KOCHI — Environment Variables Template
# Copy this file to .env and provide your actual values.
# NEVER commit your actual .env file to Git.
# ============================================================

# Authorized Admin Email
KTK_ADMIN_EMAIL=admin@example.com

# Admin Password (plaintext or SHA-256 hash)
KTK_ADMIN_PASS=your_admin_password_here
# KTK_ADMIN_PASS_HASH=

# SMTP Delivery — used for:
#   1. Admin Two-Factor OTP emails
#   2. Subscriber confirmation emails (Exclusive Property Alerts)
#   3. Admin notifications when a new subscriber signs up
#
# Option A: Gmail with an App Password
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to myaccount.google.com → Security → App passwords.
#   3. Generate an App Password for "Mail" and paste below (no spaces).
#
KTK_SMTP_HOST=smtp.gmail.com
KTK_SMTP_PORT=587
KTK_SMTP_SECURE=false
KTK_SMTP_USER=admin@example.com
KTK_SMTP_PASS=your_gmail_app_password_here
KTK_SMTP_FROM="KEY TO KOCHI <admin@example.com>"

# Subscriber data is stored in: server/data/subscribers.json (gitignored)
# No additional configuration needed — the file is created automatically.
